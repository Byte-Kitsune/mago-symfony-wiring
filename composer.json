{
  "name": "byte-kitsune/mago-symfony-wiring",
  "description": "Bounded Symfony service wiring evidence for Mago analyzer plugins.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "carthage-software/mago": "1.50.*",
    "nikic/php-parser": "^5.9",
    "symfony/yaml": "^7.4 || ^8.0"
  },
  "autoload": {
    "psr-4": { "ByteKitsune\\MagoSymfonyWiring\\": "src/" }
  },
  "config": { "allow-plugins": false, "sort-packages": true }
}
